<Project>

  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <RepositoryRootDirectory>$(MSBuildThisFileDirectory)</RepositoryRootDirectory>
    <BinDir>$(RepositoryRootDirectory)bin</BinDir>
    <OutputPath>$([System.IO.Path]::GetFullPath('$(RepositoryRootDirectory)bin\$(Configuration)'))\$(MSBuildProjectName)</OutputPath>
    <BaseIntermediateOutputPath>$([System.IO.Path]::GetFullPath('$(RepositoryRootDirectory)bin\obj\$(MSBuildProjectName)'))\</BaseIntermediateOutputPath>
    <PackageOutputPath>$(BinDir)\Packages\$(Configuration)</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <VeldridSpirvVersion>1.0.14</VeldridSpirvVersion>
    <VorticeWindowsVersion>2.4.2</VorticeWindowsVersion>
  </PropertyGroup>

  <!-- Runtime identity must stay compatible with ppy.Veldrid.SPIRV (expects 4.9.0.0). NuGet package version uses PackageVersion / yyyy.mdd.patch. -->
  <PropertyGroup Label="Assembly identity">
    <AssemblyVersion>4.9.0.0</AssemblyVersion>
    <FileVersion>4.9.0.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <Version Condition="'$(Version)' == ''">0.0.0-local</Version>
    <Authors>SK-la, Veldrid contributors</Authors>
    <Company>Ez2Lazer</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/SK-la/ez2lazer.veldrid</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SK-la/ez2lazer.veldrid</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) Veldrid contributors. Ez2Lazer packaging.</Copyright>
    <PackageReleaseNotes>Ez2Lazer-maintained Veldrid fork.</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

</Project>
