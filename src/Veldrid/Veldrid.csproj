<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Nuget">
    <PackageId>ez2lazer.Veldrid</PackageId>
    <IsPackable>true</IsPackable>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ppy.Veldrid</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DocumentationFile>$(BinDir)\$(AssemblyName).xml</DocumentationFile>
    <NoWarn Condition="'$(Configuration)' == 'Debug'">1591</NoWarn>
    <DefineConstants>$(DefineConstants);VALIDATE_USAGE</DefineConstants>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ppy.Vk" Version="1.0.26" Condition="'$(ExcludeVulkan)' != 'true'"/>
    <PackageReference Include="Vortice.D3DCompiler" Version="$(VorticeWindowsVersion)"/>
    <PackageReference Include="Vortice.Direct3D11" Version="$(VorticeWindowsVersion)"/>
    <!-- Binaries ship in this package. Private so upstream ppy.Veldrid is not a dependency. -->
    <PackageReference Include="ppy.Veldrid.SPIRV" Version="1.0.15-g5911265ec3" GeneratePathProperty="true">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="ppy.Veldrid" Version="4.9.69-ga405fe8484">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
  <!-- Bundled via CopyProjectReferencesToPackage; must not become separate NuGet dependencies. -->
    <ProjectReference Include="..\Veldrid.MetalBindings\Veldrid.MetalBindings.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
    <ProjectReference Include="..\Veldrid.OpenGLBindings\Veldrid.OpenGLBindings.csproj">
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="MTL/EmbeddedShaders/MTL_UnalignedBufferCopy_macOS.metallib">
      <LogicalName>MTL_UnalignedBufferCopy_macOS</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="MTL/EmbeddedShaders/MTL_UnalignedBufferCopy_iOS.metallib">
      <LogicalName>MTL_UnalignedBufferCopy_iOS</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <Description>A low-level, hardware-accelerated graphics and compute library for .NET, with backends for Vulkan, Metal, Direct3D 11, OpenGL, and OpenGL ES. Veldrid can be used to create high-performance 2D and 3D games, simulations, tools, and other graphical applications.</Description>
    <PackageTags>3D Graphics Direct3D DirectX Vulkan OpenGL Metal Core Standard Game</PackageTags>
  </PropertyGroup>

  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeUpstreamSpirv" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_UpstreamSpirvRoot Condition="'$(Pkgppy_Veldrid_SPIRV)' != ''">$(Pkgppy_Veldrid_SPIRV)\</_UpstreamSpirvRoot>
      <_UpstreamSpirvRoot Condition="'$(_UpstreamSpirvRoot)' == ''">$(NuGetPackageRoot)ppy.veldrid.spirv\1.0.15-g5911265ec3\</_UpstreamSpirvRoot>
    </PropertyGroup>
    <Error Text="ppy.Veldrid.SPIRV 1.0.15-g5911265ec3 was not restored." Condition="!Exists('$(_UpstreamSpirvRoot)lib\net8.0\ppy.Veldrid.SPIRV.dll')" />
    <ItemGroup>
      <_SpirvLib Include="$(_UpstreamSpirvRoot)lib\net8.0\*.*" />
      <_SpirvRuntime Include="$(_UpstreamSpirvRoot)runtimes\**\*.*" />
    </ItemGroup>
    <ItemGroup>
      <None Include="@(_SpirvLib)">
        <Pack>true</Pack>
        <PackagePath>lib/net8.0/</PackagePath>
      </None>
      <None Include="@(_SpirvRuntime)">
        <Pack>true</Pack>
        <PackagePath>runtimes/</PackagePath>
      </None>
    </ItemGroup>
  </Target>

</Project>
